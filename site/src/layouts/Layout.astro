---
import { course, href, assetHref, safeJson, firstHeadings, readingPages } from '../lib/course';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
interface Props { title?: string; activeChapter?: string; activeDocument?: string; activeSet?: string; }
const { title, activeChapter, activeDocument, activeSet } = Astro.props;
const mathConfig = {
  loader: { load: ['[tex]/configmacros', '[tex]/textmacros', '[tex]/boldsymbol'] },
  tex: { inlineMath: [['$', '$'], ['\\(', '\\)']], displayMath: [['$$', '$$'], ['\\[', '\\]']], processEscapes: true, packages: ['base', 'ams', 'configmacros', 'textmacros', 'boldsymbol'], macros: course.macroConfig },
  options: { enableMenu: false },
  startup: { typeset: false },
};
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173d36" />
    <meta name="description" content={`${course.title} — 课程笔记、知识点复习与习题。`} />
    <title>{title ? `${title} · ${course.title}` : course.title}</title>
    <script is:inline define:vars={{ mathConfig }}>window.MathJax = mathConfig;</script>
    <script is:inline defer src={assetHref('vendor/mathjax/tex-chtml.js')}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <SiteHeader />
    <button class="sidebar-scrim" aria-label="关闭目录" tabindex="-1"></button>
    <aside id="course-sidebar" class="sidebar" aria-label="课程目录">
      <button type="button" class="icon-button sidebar-close" aria-label="关闭目录">×</button>
      <nav>
        <a class:list={['nav-overview', { active: !activeChapter }]} href={href()} aria-current={!activeChapter ? 'page' : undefined}>课程导览</a>
        {course.chapters.map(chapter => <details class="nav-chapter" open={chapter.id === activeChapter || !activeChapter}>
          <summary><span class="chapter-index">{String(chapter.number).padStart(2, '0')}</span><span>{chapter.title}</span><span class="chevron" aria-hidden="true">▶</span></summary>
          <div class="nav-chapter-items">
            <a class:list={['nav-item', { active: chapter.id === activeChapter && !activeDocument && !activeSet }]} data-chapter-overview={chapter.id} href={href(`chapters/${chapter.id}/`)} aria-current={chapter.id === activeChapter && !activeDocument && !activeSet ? 'page' : undefined}>本章导览</a>
            {chapter.documents.map(id => <details class="nav-document" open={id === activeDocument}>
              <summary><a class:list={['nav-item', { active: id === activeDocument }]} href={href(`documents/${id}/`)} aria-current={id === activeDocument ? 'page' : undefined}>{course.documents[id].title}</a>{firstHeadings(id).length > 0 && <span class="chevron" aria-hidden="true">▶</span>}</summary>
              {firstHeadings(id).length > 0 && <div class="nav-headings">{firstHeadings(id).map(heading => <a href={href(`documents/${id}/#${heading.id}`)}>{heading.text}</a>)}</div>}
            </details>)}
            {chapter.sets.map(id => <a class:list={['nav-item', { active: id === activeSet }]} href={href(`sets/${id}/`)} aria-current={id === activeSet ? 'page' : undefined}><span>{course.sets[id].title}</span><span class="nav-count">{course.sets[id].problems.length}</span></a>)}
          </div>
        </details>)}
      </nav>
    </aside>
    <main id="main-content" class="main-content" tabindex="-1"><slot /></main>
    <script id="course-client-config" type="application/json" set:html={safeJson({ projectId: course.projectId || 'default', title: course.title, revision: course.revision, basePath: course.basePath, siteUrl: course.siteUrl, readingPages, chapters: course.chapters.map(({ id, title }) => ({ id, title })) })}></script>
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
