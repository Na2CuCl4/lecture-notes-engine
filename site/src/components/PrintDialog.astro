---
interface Props { chapterId?: string; includeDocuments?: boolean; }
const { chapterId, includeDocuments = false } = Astro.props;
---
<dialog class="print-dialog" aria-labelledby="print-title">
  <div class="dialog-header"><div><span class="eyebrow">TAKE YOUR NOTES WITH YOU</span><h2 id="print-title">排版与打印</h2></div><button class="icon-button" data-print-close aria-label="关闭打印面板" type="button">×</button></div>
  <p class="print-summary"></p>
  <form class="print-options">
    <fieldset><legend>解答位置</legend><div class="radio-options"><label><input type="radio" name="print-solutions" value="none" checked /><span>仅题目</span></label><label><input type="radio" name="print-solutions" value="inline" /><span>题后解答</span></label><label><input type="radio" name="print-solutions" value="end" /><span>文末解答</span></label></div></fieldset>
    <div class="print-checkboxes"><label><input type="checkbox" name="print-comments" /> 包含评注与拓展</label>{chapterId && <label><input type="checkbox" name="print-documents" checked={includeDocuments} /> 包含本章知识点文档</label>}</div>
    <p class="print-note">PDF 按章节生成；包含多个章节时，会分别提供下载。你可以继续阅读，稍后回到此处查看结果。</p>
    <button class="button button-primary" type="submit" data-print-submit>生成 PDF</button>
  </form>
  <div class="print-error" role="alert" hidden></div>
  <div class="print-jobs" aria-live="polite"></div>
</dialog>
