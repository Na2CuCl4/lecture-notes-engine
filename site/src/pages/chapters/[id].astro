---
import Layout from '../../layouts/Layout.astro';
import ExerciseList from '../../components/ExerciseList.astro';
import { course, href } from '../../lib/course';
export function getStaticPaths() { return course.chapters.map(chapter => ({ params: { id: chapter.id }, props: { chapter } })); }
const { chapter } = Astro.props;
---
<Layout title={chapter.title} activeChapter={chapter.id}>
  <div class="page-container" data-chapter-page={chapter.id}><nav class="breadcrumbs" aria-label="当前位置"><a href={href()}>课程导览</a><span aria-hidden="true">/</span><span>第 {chapter.number} 章 {chapter.title}</span><span aria-hidden="true">/</span><span aria-current="page">本章导览</span></nav><header class="page-heading"><h1>{chapter.title}</h1><div class="prose chapter-introduction" data-math set:html={chapter.body.html}></div></header>
    {chapter.documents.length > 0 && <section class="document-collection" aria-labelledby="documents-heading"><div class="section-heading compact"><h2 id="documents-heading">知识点复习</h2><span class="section-count">{chapter.documents.length} 篇文档</span></div><div class="document-links">{chapter.documents.map((id, index) => <a href={href(`documents/${id}/`)}><span class="document-link-index">{String(index + 1).padStart(2, '0')}</span><span><strong>{course.documents[id].title}</strong><small>{course.documents[id].tags.join(' · ') || '概念、性质与证明'}</small></span><span aria-hidden="true">→</span></a>)}</div></section>}
    {chapter.sets.length > 0 && <section class="related-sets"><div class="section-heading compact"><h2>本章习题集</h2><span class="section-count">{chapter.sets.length} 个习题集</span></div><div class="set-links">{chapter.sets.map(id => <a href={href(`sets/${id}/`)}><div><h3>{course.sets[id].title}</h3><p>{course.sets[id].problems.length} 道习题</p></div><span aria-hidden="true">↗</span></a>)}</div></section>}
    <ExerciseList problems={chapter.problems.map(id => course.problems[id])} chapterId={chapter.id} title="所有习题" includeDocuments />
  </div>
</Layout>
