---
import Layout from '../layouts/Layout.astro';
import { course, href, assetHref } from '../lib/course';
const count = Object.keys(course.problems).length;
---
<Layout>
  <div class="page-container home-page">
    <div class="home-topline"><span class="eyebrow">COURSE COMPANION</span><span>{course.author}</span></div>
    <section class="course-hero"><div class="hero-copy"><span class="hero-label"><span></span>概念 · 证明 · 习题</span><h1>{course.title}</h1><p>{course.subtitle || '把零散的知识连成线，让每一道习题成为理解的下一步。'}</p><div class="hero-actions">{course.chapters[0] && <a class="button button-primary" href={href(`chapters/${course.chapters[0].id}/`)}>开始阅读 <span aria-hidden="true">→</span></a>}<a class="text-link" href={assetHref('downloads/main.pdf')}>下载完整讲义 <span aria-hidden="true">↗</span></a></div></div><div class="hero-art" aria-hidden="true"><span class="math-flourish">∫</span><svg viewBox="0 0 300 180"><path class="axis" d="M20 140H280M60 165V15"/><path class="curve-fill" d="M60 140C95 130 90 47 145 55S210 132 255 35V140Z"/><path class="curve" d="M25 144C105 160 85 45 145 55S220 146 272 12"/><path class="tangent" d="M94 102 205 19"/><circle cx="145" cy="64" r="4"/></svg><span class="art-caption">从直觉走向严格</span></div></section>
    <div class="course-meta"><span><strong>{String(course.chapters.length).padStart(2, '0')}</strong> 个章节</span><span><strong>{count}</strong> 道习题</span><span>知识复习与多种解法</span><span>在线阅读 · 按章打印</span></div>
    <section class="chapter-collection"><div class="section-heading"><div><span class="eyebrow">A PATH THROUGH THE COURSE</span><h2>沿着章节，逐步深入</h2></div><span class="section-aside">选择你正在学习的部分</span></div><div class="chapter-grid">{course.chapters.map(chapter => <article class="chapter-card"><div class="chapter-card-top"><span>{String(chapter.number).padStart(2, '0')}</span><span aria-hidden="true">↗</span></div><h3><a href={href(`chapters/${chapter.id}/`)}>{chapter.title}</a></h3><p>{chapter.body.text || '回顾核心概念，通过习题检验与深化理解。'}</p><div class="chapter-card-meta"><span>{chapter.documents.length} 篇文档</span><span>{chapter.problems.length} 道习题</span><span>{chapter.sets.length} 个习题集</span></div></article>)}</div></section>
    <section class="reading-note"><span class="reading-note-mark" aria-hidden="true">“</span><div><h2>先独立思考，再展开解答。</h2><p>你可以按知识点与难度寻找习题，随机抽取一组练习，也可以把题单排成 PDF，留一段离开屏幕的思考时间。</p></div></section>
    <footer class="page-footer"><span>{course.title}</span><span>{course.author} · 习题课笔记</span></footer>
  </div>
</Layout>
