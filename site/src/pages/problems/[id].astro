---
import Layout from '../../layouts/Layout.astro';
import ExerciseList from '../../components/ExerciseList.astro';
import { course, href } from '../../lib/course';
export function getStaticPaths() { return Object.values(course.problems).map(problem => ({ params: { id: problem.id }, props: { problem } })); }
const { problem } = Astro.props;
const chapter = course.chapters.find(item => item.id === problem.chapterId);
const sets = Object.values(course.sets).filter(set => set.problems.includes(problem.id));
---
<Layout title={`题 ${problem.number}${problem.title ? ` · ${problem.title}` : ''}`} activeChapter={chapter?.id}>
  <div class="page-container single-problem-page"><nav class="breadcrumbs" aria-label="当前位置">{chapter && <><a href={href(`chapters/${chapter.id}/`)}>第 {chapter.number} 章 {chapter.title}</a><span aria-hidden="true">/</span></>}<span aria-current="page">题 {problem.number}</span></nav><header class="page-heading"><h1>{problem.title || `题 ${problem.number}`}</h1></header><ExerciseList problems={[problem]} chapterId={problem.chapterId} title={`题 ${problem.number}`} showHeading={false} standalone />{sets.length > 0 && <section class="problem-memberships"><h2>也收录于</h2>{sets.map(set => <a href={href(`sets/${set.id}/`)}>{set.title}</a>)}</section>}</div>
</Layout>
