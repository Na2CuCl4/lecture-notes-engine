---
import Layout from '../../layouts/Layout.astro';
import { course, href, chapterForDocument } from '../../lib/course';
export function getStaticPaths() { return Object.values(course.documents).map(document => ({ params: { id: document.id }, props: { document } })); }
const { document } = Astro.props;
const chapter = chapterForDocument(document.id);
---
<Layout title={document.title} activeChapter={chapter?.id} activeDocument={document.id}>
  <div class="page-container document-page">
    <nav class="breadcrumbs" aria-label="当前位置"><a href={href()}>课程导览</a>{chapter && <><span aria-hidden="true">/</span><a href={href(`chapters/${chapter.id}/`)}>第 {chapter.number} 章 {chapter.title}</a></>}<span aria-hidden="true">/</span><span aria-current="page">知识点复习</span></nav>
    <header class="page-heading"><h1>{document.title}</h1><div class="document-tags">{document.tags.map(tag => <span class="tag">{tag}</span>)}</div></header>
    <article class="prose document-prose" data-math set:html={document.body.html}></article>
  </div>
</Layout>
