# Copy to .env. Compose paths are resolved against this repository.
PROJECTS_PATH=./projects.yaml
# Bind only to the local host by default; use your existing reverse proxy for HTTPS.
WEB_BIND=127.0.0.1
WEB_PORT=3000
ENGINE_IMAGE=lecture-notes-engine
ENGINE_VERSION=local
# Optional mirror hostname for the build only, e.g. mirrors.tuna.tsinghua.edu.cn.
APT_MIRROR=deb.debian.org
PRINT_CONCURRENCY=1
PRINT_TIMEOUT_MS=180000
BOOK_TIMEOUT_MS=900000
PRINT_MAX_QUEUED=30
PRINT_MAX_ACTIVE_PER_SOURCE=3
PRINT_MAX_PROBLEMS=500
PRINT_LEASE_MS=60000
PRINT_MAX_ATTEMPTS=2
PRINT_CACHE_TTL_HOURS=168
PRINT_CACHE_MAX_MB=1024
PRINT_LOG_TTL_HOURS=168
# Leave false for direct local access. In production set only the trusted proxy's CIDR.
TRUST_PROXY=false
