# Two Docker Hub repositories use the same version tag.
DOCKERHUB_NAMESPACE=na2cucl4
ENGINE_VERSION=v1.0.0

# Host paths, relative to compose.yaml unless absolute.
PROJECTS_PATH=./projects.yaml
CONTENT_ROOT=./content

# Keep loopback binding when using an existing reverse proxy.
# Set 0.0.0.0 only when direct access to the host's port is intended.
WEB_BIND=127.0.0.1
WEB_PORT=3000
TRUST_PROXY=false

# Shared limit across worker and one-shot builder.
PRINT_CONCURRENCY=1
PRINT_TIMEOUT_MS=180000
BOOK_TIMEOUT_MS=900000
PRINT_CACHE_TTL_HOURS=168
PRINT_CACHE_MAX_MB=1024
